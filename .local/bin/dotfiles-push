#!/usr/bin/env bash
# dotfiles-push: resign unpushed unsigned commits, then push — in ONE command.
#
# Replaces the two-step "pre-push resign then re-run" flow. git's `pre-push`
# hook cannot complete a push in one command (by the time it runs, the refs to
# send are already resolved, so re-signing mid-hook makes the outer push send a
# stale SHA and exit nonzero). So this wrapper does the resign itself, then
# `exec`s the real push with the caller's exact arguments.
#
# Flow:
#   1. Find unpushed unsigned commits on the current branch
#      (commit.gpgsign=false locally, so managed-skill auto-commits are unsigned).
#   2. If any, re-sign them via `git rebase --rebase-merges --exec
#      'git commit --amend --no-edit -S'` (one fingerprint scan; gpg-agent
#      caches the passphrase for default-cache-ttl=300s to cover the batch).
#   3. exec the real git push with "$@" unchanged (preserves flags like
#      --force, --set-upstream, etc.).
#
# Only touches UNPUSHED commits — already-published history is never rewritten.
set -u

DOT_GIT_DIR="$HOME/.dotfiles"
DOT_WORK_TREE="$HOME"

# Figure out the branch being pushed and its upstream's remote tip.
branch="$(git --git-dir="$DOT_GIT_DIR" --work-tree="$DOT_WORK_TREE" \
  rev-parse --abbrev-ref HEAD 2>/dev/null)"
[ -z "$branch" ] && branch="main"
base="$(git --git-dir="$DOT_GIT_DIR" --work-tree="$DOT_WORK_TREE" \
  rev-parse --abbrev-ref --symbolic-full-name "@{upstream}" 2>/dev/null)"
# base like refs/remotes/origin/main -> origin/main
base="${base#refs/remotes/}"

unpushed="$(git --git-dir="$DOT_GIT_DIR" --work-tree="$DOT_WORK_TREE" \
  rev-list "$base"..HEAD 2>/dev/null || true)"

missing_shot=false
to_sign=""
for sha in $unpushed; do
  if ! git --git-dir="$DOT_GIT_DIR" --work-tree="$DOT_WORK_TREE" cat-file -p "$sha" \
      2>/dev/null | grep -q '^gpgsig'; then
    to_sign="$to_sign $sha"
  fi
done

if [ -n "$to_sign" ]; then
  n=$(echo "$to_sign" | wc -w | tr -d ' ')
  echo "dotfiles-push: re-signing $n unpushed unsigned commit(s) (one fingerprint scan)..."
  if ! git --git-dir="$DOT_GIT_DIR" --work-tree="$DOT_WORK_TREE" \
      rebase --rebase-merges --exec 'git commit --amend --no-edit -S' "$base" 2>&1; then
    echo "dotfiles-push: ERROR — resign rebase failed. Resolve conflicts, then run 'dotfiles push' again." >&2
    exit 1
  fi
  echo "dotfiles-push: resigned. pushing now."
elif [ -z "$base" ]; then
  # No upstream yet — just push (nothing to resign relative to a remote).
  :
else
  echo "dotfiles-push: nothing to re-sign; pushing."
fi

# The wrapper is the sole resign authority. Mark the global pre-push hook as
# already-resigned so it exits immediately (its re-entry guard) instead of
# re-scanning or aborting during our push.
export GIT_PRE_PUSH_RESIGNED=1

# exec the real push with the caller's exact args (e.g. `push -u origin main`).
exec git --git-dir="$DOT_GIT_DIR" --work-tree="$DOT_WORK_TREE" push "$@"
