#!/usr/bin/env bash
# git-resign-own <upstream-ref>      sign own unsigned commits in <upstream-ref>..HEAD
# git-resign-own --new-branch        same, but "unpushed" = reachable from HEAD and no remote ref
#
# GPG-sign the UNPUSHED, UNSIGNED commits in the chosen range that were
# authored by the configured git identity (`git config user.email`). Commits by
# anyone else are replayed byte-identical in content and left UNSIGNED: the
# rebase still gives descendants new SHAs (unavoidable — parent SHAs changed),
# but your GPG key is never put on their commits.
#
# Contract
#   precondition:  inside a git work tree; user.email is configured;
#                  <upstream-ref> (if given) is an ancestor of HEAD.
#   postcondition: exit 0 and every unpushed commit authored by user.email is
#                  signed (or there was nothing to sign). Commits authored by
#                  others keep their content, author, and unsigned state.
#   exit 1:        rebase failed (repo left as git left it).
set -u

arg="${1:?usage: git-resign-own <upstream-ref> | --new-branch}"

email="$(git config user.email)"
if [ -z "$email" ]; then
  echo "git-resign-own: ERROR — git config user.email is not set; cannot tell which commits are ours." >&2
  exit 1
fi

# Unpushed commits, oldest first, as "<sha> <author-email>". Captured into a
# variable first (not `mapfile < <(...)`) so a bad ref fails loudly instead of
# silently yielding an empty list.
if [ "$arg" = "--new-branch" ]; then
  log_out="$(git log --reverse --format='%H %ae' HEAD --not --remotes)" || exit 1
else
  log_out="$(git log --reverse --format='%H %ae' "$arg"..HEAD)" || exit 1
fi
rows=()
[ -n "$log_out" ] && mapfile -t rows <<<"$log_out"

own_unsigned=()          # SHAs we need to sign, oldest first
first_idx=-1             # index in rows of the oldest commit we need to sign
for i in "${!rows[@]}"; do
  sha="${rows[$i]%% *}"
  author="${rows[$i]#* }"
  [ "$author" = "$email" ] || continue
  # Unsigned iff the commit object has no gpgsig header. (%G? reports E for
  # signed commits whose key is not in the keyring, so it cannot be used.)
  git cat-file -p "$sha" | grep -q '^gpgsig' && continue
  own_unsigned+=("$sha")
  [ "$first_idx" -lt 0 ] && first_idx=$i
done
if [ "${#own_unsigned[@]}" -eq 0 ]; then
  exit 0
fi


# Sign only our own unsigned commits: the --exec hook checks each replayed
# commit and amends (-S) just those authored by us that lack a gpgsig header.
# Everyone else's commits replay untouched and stay unsigned. (--no-gpg-sign
# defeats commit.gpgsign=true, which would otherwise sign every replayed
# commit including other authors'.)
echo "git-push: re-signing ${#own_unsigned[@]} unpushed unsigned commit(s) by $email (one fingerprint scan)..."
# Replay from just below the oldest commit to sign, not from upstream, so
# earlier history is untouched. A root commit has no parent: use --root.
if git rev-parse --verify -q "${own_unsigned[0]}~1" >/dev/null; then
  rebase_onto=("${own_unsigned[0]}~1")
else
  rebase_onto=(--root)
fi
exec_cmd="if [ \"\$(git log -1 --format=%ae HEAD)\" = \"$email\" ] && ! git cat-file -p HEAD | grep -q '^gpgsig'; then git commit --amend --no-edit -S; fi"

# Run the rebase in a throwaway detached worktree, never in the caller's own
# work tree. For a bare repo whose work tree is $HOME (the dotfiles repo), an
# in-place rebase checks out every intermediate commit INTO $HOME: files that
# only exist at later commits are deleted mid-rebase (including ~/.local/bin/
# pinentry-fprintd, which makes gpg fail with "No pinentry"), and stale versions
# of live config (global git hooks, omp extensions) are resurrected. A separate
# worktree sees those checkouts instead, so the live tree is never touched.
git_dir="$(git rev-parse --absolute-git-dir)" || exit 1
branch="$(git symbolic-ref -q --short HEAD)" || {
  echo "git-resign-own: ERROR — HEAD is detached; refusing to move a branch." >&2
  exit 1
}
orig_tip="$(git rev-parse HEAD)"
wt="$(mktemp -d "${TMPDIR:-/tmp}/git-resign-own.XXXXXX")" || exit 1
cleanup() { git --git-dir="$git_dir" worktree remove --force "$wt" >/dev/null 2>&1; rm -rf "$wt"; }
trap cleanup EXIT

# Override any inherited GIT_DIR/GIT_WORK_TREE so every command below is bound
# to the temp worktree and cannot reach the caller's work tree.
if ! git --git-dir="$git_dir" worktree add -q --detach "$wt" "$orig_tip"; then
  echo "git-resign-own: ERROR — could not create temp worktree." >&2
  exit 1
fi
if ! (
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
  cd "$wt" && git rebase --no-gpg-sign --rebase-merges --exec "$exec_cmd" "${rebase_onto[@]}" 2>&1
); then
  echo "git-resign-own: ERROR — resign rebase failed in temp worktree $wt; your branch and work tree were NOT modified." >&2
  exit 1
fi

# Read HEAD from inside the worktree. Passing --git-dir would resolve HEAD
# against the main repo (the branch we started on), not the worktree's own
# detached HEAD, and silently return the unsigned original tip.
new_tip="$(unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; cd "$wt" && git rev-parse HEAD)" || exit 1
if [ "$new_tip" = "$orig_tip" ]; then
  echo "git-resign-own: ERROR — rebase finished but the tip did not change; nothing was signed." >&2
  exit 1
fi
# The rewritten history must have identical content to what we started with.
if [ "$(git --git-dir="$git_dir" rev-parse "$new_tip^{tree}")" != "$(git --git-dir="$git_dir" rev-parse "$orig_tip^{tree}")" ]; then
  echo "git-resign-own: ERROR — resigned tip has a different tree than the original; refusing to move $branch." >&2
  exit 1
fi
# Advance the branch only if it still points where we started (a concurrent
# commit, e.g. the managed-skill autosync, must not be silently overwritten).
if ! git --git-dir="$git_dir" update-ref "refs/heads/$branch" "$new_tip" "$orig_tip"; then
  echo "git-resign-own: ERROR — $branch moved while resigning; nothing changed. Push again." >&2
  exit 1
fi
