        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "wils.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "tray": [
        {
          "id": "omarchy.keyboard-layout"
        }
      ]
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "wils.notifications"
