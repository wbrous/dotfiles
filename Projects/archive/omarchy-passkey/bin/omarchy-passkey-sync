#!/usr/bin/python3
# omarchy:summary=Sync passkeys between the local authenticator and the Bitwarden vault
# omarchy:group=passkey
# omarchy:args=<pull|push>
"""`pull` runs before the authenticator starts, `push` after it registers something.

Exit codes: 0 synced, 3 vault locked (the user must unlock; nothing was changed),
4 conflict (same credential id, different key; nothing was changed), 2 other error.
"""

import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import bw_vault
import passkey_paths
import passkey_store
import passkey_sync


EXIT_LOCKED, EXIT_CONFLICT, EXIT_ERROR = 3, 4, 2


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in ("pull", "push"):
        print("usage: omarchy-passkey-sync <pull|push>", file=sys.stderr)
        return EXIT_ERROR
    operation = passkey_sync.pull if argv[0] == "pull" else passkey_sync.push
    try:
        store = passkey_paths.store_dir()
        vault = bw_vault.Vault(bw_vault.unix_transport(passkey_paths.vault_socket()))
    except RuntimeError as exc:
        print(f"omarchy-passkey-sync: {exc}", file=sys.stderr)
        return EXIT_ERROR
    try:
        result = operation(vault, store)
    except bw_vault.VaultLocked as exc:
        print(f"omarchy-passkey-sync: vault is locked ({exc})", file=sys.stderr)
        return EXIT_LOCKED
    except passkey_sync.SyncConflict as exc:
        print(f"omarchy-passkey-sync: {exc}", file=sys.stderr)
        return EXIT_CONFLICT
    except (bw_vault.VaultError, passkey_store.StoreError) as exc:
        print(f"omarchy-passkey-sync: {exc}", file=sys.stderr)
        return EXIT_ERROR
    print(
        f"{argv[0]}: pulled {result.pulled}, pushed {result.pushed}, "
        f"vault counters {result.counters_raised_in_vault}, local counters {result.counters_raised_locally}"
    )
    for line in result.skipped_in_vault:
        print(f"skipped (not P-256): {line}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
