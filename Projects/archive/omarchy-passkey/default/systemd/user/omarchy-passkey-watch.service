[Unit]
Description=Back up new passkeys to Bitwarden as they are created
After=omarchy-passkey-vault.service
PartOf=omarchy-passkey.service

[Service]
Type=simple
ExecStart=/usr/local/bin/omarchy-passkey-watch
Restart=on-failure
RestartSec=3
LimitCORE=0
NoNewPrivileges=true

[Install]
WantedBy=omarchy-passkey.service
