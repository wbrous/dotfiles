#!/usr/bin/python3
"""Unlock the invoking user's `bw serve` with the master password, as root.

Run only through `pkexec`, which makes polkit demand a fingerprint scan first
(com.gir0fa.omarchy-passkey-unlock, auth_admin, never cached).

Why this exists: the master password must never reach a process the user (or
malware running as the user) can read. So root decrypts it from a root-only sealed
credential and sends it straight to the user's `bw serve`; it is not printed, not
returned, not placed in an environment variable or argument. The caller learns only
the exit code.

Takes NO arguments and reads NO environment other than PKEXEC_UID, which pkexec sets
from the real caller and the caller cannot forge. The socket is derived from it:
/run/user/<uid>/omarchy-passkey/bw.sock

The one way this helper could leak the password is by sending it to the wrong
listener, and the user is the adversary here, so a check of the socket PATH is not
enough: the user can swap the socket between the check and the connect. Instead the
helper CONNECTS FIRST and then asks the kernel who is on the other end (SO_PEERCRED).
It sends the password only if that peer is the invoking user running /usr/bin/bw. A
user cannot make an arbitrary program's /proc/<pid>/exe be a root-owned /usr/bin/bw.

Exit codes: 0 unlocked, 1 refused (wrong peer / not via pkexec), 2 server said no or
unreachable, 3 sealed credential missing or unreadable.
"""

import http.client
import json
import os
import socket
import stat
import struct
import subprocess
import sys

SEALED_CREDENTIAL = "/etc/omarchy-passkey/master.cred"
CREDENTIAL_NAME = "omarchy-passkey-master"
BW_BINARY = "/usr/bin/bw"
HOST_HEADER = "localhost:8087"  # bw serve's DNS-rebinding guard requires host:port


class UnixConnection(http.client.HTTPConnection):
    """HTTP over a Unix socket (urllib cannot do this).

    `connect` calls `verify_peer` on the CONNECTED socket before any request byte is
    sent, so the password can never be written to an unverified listener.
    """

    def __init__(self, path: str, timeout: float, expected_uid: int):
        super().__init__(HOST_HEADER, timeout=timeout)
        self._path = path
        self._expected_uid = expected_uid

    def connect(self) -> None:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(self.timeout)
        try:
            sock.connect(self._path)
            verify_peer(sock, self._expected_uid)
        except BaseException:
            sock.close()
            raise
        self.sock = sock


def refuse(message: str, code: int = 1) -> "NoReturn":  # noqa: F821
    print(f"omarchy-passkey-unlock-root: {message}", file=sys.stderr)
    sys.exit(code)


def invoking_uid() -> int:
    raw = os.environ.get("PKEXEC_UID")
    if raw is None or not raw.isdigit():
        refuse("must be run through pkexec")
    uid = int(raw)
    if uid == 0:
        refuse("refusing to unlock root's own vault")
    return uid


def socket_path_for(uid: int) -> str:
    return f"/run/user/{uid}/omarchy-passkey/bw.sock"


def peer_credentials(sock: socket.socket) -> tuple[int, int]:
    """(pid, uid) of the process on the other end, as recorded by the kernel at connect."""
    pid, uid, _gid = struct.unpack("3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
    return pid, uid


def verify_peer(sock: socket.socket, expected_uid: int) -> None:
    """Refuse unless the connected peer is `expected_uid` running BW_BINARY.

    Raises SystemExit(1) otherwise. The kernel supplies the pid and uid at connect
    time, so neither can be changed by swapping the socket file afterwards.
    """
    pid, uid = peer_credentials(sock)
    if uid != expected_uid:
        refuse(f"listener runs as uid {uid}, not the invoking user")
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        refuse("cannot identify the listener process")
    if exe != BW_BINARY:
        refuse(f"listener is not {BW_BINARY}")


def read_secret() -> bytes:
    """Decrypt the sealed master password. Never returns it to anyone but main().

    The credential file must be a root-owned regular file that no one else can read,
    so a user cannot have planted their own sealed blob for us to decrypt and send.
    """
    try:
        st = os.lstat(SEALED_CREDENTIAL)
    except OSError as exc:
        refuse(f"cannot read {SEALED_CREDENTIAL}: {exc.strerror}", 3)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o077:
        refuse(f"{SEALED_CREDENTIAL} must be a root-owned regular file with mode 600", 3)
    try:
        result = subprocess.run(
            ["/usr/bin/systemd-creds", "decrypt", f"--name={CREDENTIAL_NAME}", SEALED_CREDENTIAL, "-"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            env={}, check=False,
        )
    except OSError as exc:
        refuse(f"cannot run systemd-creds: {exc.strerror}", 3)
    secret = result.stdout.rstrip(b"\n")
    if result.returncode != 0 or not secret:
        refuse("could not decrypt the sealed master password", 3)
    return secret


def main() -> int:
    if sys.argv[1:]:
        refuse("takes no arguments")
    uid = invoking_uid()

    connection = UnixConnection(socket_path_for(uid), timeout=30, expected_uid=uid)
    body = b""
    try:
        try:
            connection.connect()  # verifies the peer; SystemExit(1) if it is not bw
        except FileNotFoundError:
            refuse("bw serve is not running (no socket)", 2)
        except OSError as exc:
            refuse(f"cannot connect to bw serve: {exc.strerror}", 2)
        # Only now, with a verified peer, is the secret decrypted at all.
        body = json.dumps({"password": read_secret().decode("utf-8")}).encode()
        connection.request(
            "POST", "/unlock", body=body,
            headers={"Content-Type": "application/json", "Content-Length": str(len(body))},
        )
        reply = json.loads(connection.getresponse().read())
    except (OSError, http.client.HTTPException, json.JSONDecodeError):
        refuse("bw serve did not answer", 2)
    finally:
        connection.close()
        body = b""

    if reply.get("success") is True:
        return 0
    # The server's message can be shown: it never contains the password.
    refuse(f"bw serve refused: {reply.get('message', 'unknown error')}", 2)


if __name__ == "__main__":
    sys.exit(main())
